# PostgreSQL
#
# Supabase: KHÔNG dùng chuỗi "Session pool" (lỗi EMAXCONNSESSION / max 15 clients).
# Dùng "Transaction pool" — port 6543 + thêm ?pgbouncer=true
# Ví dụ:
# DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-....pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Tuỳ chọn (giảm áp pool): &connection_limit=1
DATABASE_URL="postgresql://user:password@localhost:5432/hoclieu_db"

# NextAuth — tạo secret: openssl rand -base64 32
# Quan trọng: khi chạy local, NEXTAUTH_URL phải là http://localhost:3000 (không để URL Vercel).
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="thay-bang-chuoi-bi-mat-dai"

# Uploadthing v7 — lấy từ dashboard https://uploadthing.com
UPLOADTHING_TOKEN="sk_live_..."

# (Tuỳ chọn) Biến cũ, một số hướng dẫn vẫn dùng:
# UPLOADTHING_SECRET=
# UPLOADTHING_APP_ID=
